# 复制为 .env 后填写。.env 已被 .gitignore 排除,绝不提交。
# 随机串可用:python3 -c "import secrets;print(secrets.token_urlsafe(32))"

# 每台设备一个网关 Token(Kelivo 供应商的 API Key 填对应的那一个)
GATEWAY_DEVICES=pc=CHANGE_ME_PC_TOKEN,phone=CHANGE_ME_PHONE_TOKEN
GATEWAY_ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN

# 上游:同一时间只用一个。中转就改 BASE_URL 和 KEY。BASE_URL 必须以 /v1 结尾
UPSTREAM_BASE_URL=https://api.deepseek.com/v1
UPSTREAM_API_KEY=CHANGE_ME
UPSTREAM_MODEL=deepseek-flash

# 记忆侧的抽取/打标模型:默认与上游完全相同,不用填。
# 想让记忆侧换一个模型或换一家时,取消注释并填写:
# MEMORY_LLM_BASE_URL=https://api.deepseek.com/v1
# MEMORY_LLM_MODEL=deepseek-flash
# MEMORY_LLM_API_KEY=CHANGE_ME

# 向量化与重排序(ADR-0007)
SILICONFLOW_API_KEY=CHANGE_ME

# 两个记忆库的内部鉴权(只有网关用)
HINDSIGHT_API_KEY=CHANGE_ME
OMBRE_MCP_TOKEN=CHANGE_ME
OMBRE_DASHBOARD_PASSWORD=CHANGE_ME

# 手机经 Tailscale 访问(可选):留空则用 docker compose logs tailscale 里的链接登录
TS_AUTHKEY=

# 抓包开关:>0 时把最近 N 次 Kelivo 原始请求存到 data/gateway/debug(不含 Token),排查完改回 0
GATEWAY_DEBUG_CAPTURE=0

# 手机入口(Tailscale)默认不启动;需要时取消下一行注释
# COMPOSE_PROFILES=phone
